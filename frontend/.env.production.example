# Production Frontend Environment Variables (e.g. Vercel, Netlify, Cloudflare Pages)

# Live Backend URL (without trailing slash)
# Replace with your deployed backend URL (e.g. Render, Railway, AWS, Fly.io)
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api/v1

# Application Settings
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_AGENT_VISUALIZATION=true
