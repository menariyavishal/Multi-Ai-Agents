# Production Backend Environment Configuration
# Copy this to your cloud hosting environment variables (e.g. Render, Railway, Cloud Run)

# Flask & Server Environment
FLASK_ENV=production
PORT=8000
SECRET_KEY=generate-a-strong-random-32-char-secret-key-here

# LLM Keys
# Required for 5-agent pipeline execution
GROQ_API_KEY=gsk_your_groq_api_key_here

# MongoDB Database
# Connect to your free MongoDB Atlas M0 cluster:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/multi_ai_agents?retryWrites=true&w=majority
MONGODB_DB_NAME=multi_ai_agents

# Real-Time Data Sources (Optional but recommended for live search & stats)
OPENWEATHER_API_KEY=your_openweather_api_key_here
NEWS_API_KEY=your_news_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here

# Timeouts & Concurrency
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
AGENT_TIMEOUT=25
GRAPH_TIMEOUT=35
MAX_ITERATIONS=3
LOG_LEVEL=INFO
